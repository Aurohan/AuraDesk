<Project Sdk="Microsoft.NET.Sdk">

  <!--
    System services: window, display, DPI, fullscreen, hotkey and shell integration.

    Targets net10.0-windows because these are Windows API calls. Deliberately does NOT
    reference WPF, so the interop layer stays usable from any UI and can be exercised from
    a console test host.

    No third-party package references: the Win32 surface we need is declared by hand in
    Interop/ rather than pulled from a helper library.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>GlassDesk.Platform</RootNamespace>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS0649;CA1806;CS8605;CS8607</NoWarn>
  </PropertyGroup>

</Project>