<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GlassDesk.Dock.MediaPlaybackControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dock="clr-namespace:GlassDesk.Dock;assembly=GlassDesk.Dock">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="PlaybackButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Background" Value="#20FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Chrome" CornerRadius="10" Background="{TemplateBinding Control.Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Border.Background" Value="#38FFFFFF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="UIElement.Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border CornerRadius="25" Background="#20FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" Padding="12,10">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="62" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Width="54" Height="54" CornerRadius="16" Background="#20FFFFFF" VerticalAlignment="Center">
        <Grid ClipToBounds="True">
          <Image Name="ArtworkImage" Stretch="UniformToFill" Visibility="Collapsed" />
          <TextBlock Name="ArtworkPlaceholder" Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <Grid Column="1" Margin="4,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="36" />
        </Grid.RowDefinitions>
        <TextBlock Name="TitleText" Text="暂无媒体" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis" />
        <TextBlock Name="ArtistText" Grid.Row="1" Text="播放音乐或视频后显示" FontSize="10" Foreground="#BFFFFFFF" TextTrimming="CharacterEllipsis" Margin="0,2,0,3" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
          <Button Name="PreviousButton" Style="{StaticResource PlaybackButton}" ToolTip="上一首" IsEnabled="False" Click="OnPreviousClick">
            <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
          </Button>
          <Button Name="PlayPauseButton" Style="{StaticResource PlaybackButton}" ToolTip="播放/暂停" IsEnabled="False" Click="OnPlayPauseClick">
            <TextBlock Name="PlayPauseGlyph" Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
          </Button>
          <Button Name="NextButton" Style="{StaticResource PlaybackButton}" ToolTip="下一首" IsEnabled="False" Click="OnNextClick">
            <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>