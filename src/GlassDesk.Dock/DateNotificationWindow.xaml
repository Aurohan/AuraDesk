<?xml version="1.0" encoding="utf-8"?>
<controls:GlassWindow x:Class="GlassDesk.Dock.DateNotificationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI" Title="日期与通知" Width="336" Height="500" ShowInTaskbar="False" WindowStartupLocation="Manual" Topmost="True" xmlns:dock="clr-namespace:GlassDesk.Dock;assembly=GlassDesk.Dock">
  <Grid ClipToBounds="True">
    <controls:LiquidGlassSurface Name="GlassSurface" UseFrostedMaterial="True" BackgroundClarityOverride="0.35" />
    <Grid Name="PopupContent" Margin="18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="1" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Name="LargeTimeText" FontSize="34" FontWeight="SemiBold" Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        <TextBlock Name="LargeDateText" FontSize="13" Margin="2,-2,0,8" Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      </StackPanel>
      <Border Grid.Row="1" CornerRadius="22" Background="#16FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="10" Margin="0,4,0,14">
        <Calendar Name="MonthCalendar" BorderThickness="0" Background="#00FFFFFF" HorizontalAlignment="Stretch" IsTodayHighlighted="True" />
      </Border>
      <Rectangle Grid.Row="2" Height="1" Fill="#26FFFFFF" />
      <Grid Row="3" Margin="0,14,0,0" MinHeight="142">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="通知" FontSize="15" FontWeight="SemiBold" Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Border Name="NotificationInfoPanel" Grid.Row="1" Margin="0,8,0,10" MinHeight="76" CornerRadius="18" Background="#16FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="12,10">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Name="NotificationInfoText" Text="Windows 通知由系统通知中心管理" FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="250" LineHeight="16" Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
          </StackPanel>
        </Border>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="桌面便签" Height="34" Margin="0,0,4,0" Cursor="Hand" Background="#20FFFFFF" BorderBrush="#2FFFFFFF" Foreground="#FFFFFFFF" Click="OnOpenStickyNotesClick" />
          <Button Grid.Column="1" Content="通知设置" Height="34" Margin="4,0,0,0" Cursor="Hand" Background="#20FFFFFF" BorderBrush="#2FFFFFFF" Foreground="#FFFFFFFF" Click="OnNotificationSettingsClick" />
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</controls:GlassWindow>