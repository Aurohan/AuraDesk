<?xml version="1.0" encoding="utf-8"?>
<controls:GlassWindow x:Class="GlassDesk.Dock.MediaCapsuleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI" Title="正在播放" Width="378" Height="76" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual" Topmost="True" xmlns:dock="clr-namespace:GlassDesk.Dock;assembly=GlassDesk.Dock">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="MediaButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="BorderBrush" Value="#20FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="ButtonSurface" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="ButtonSurface" Property="Border.Background" Value="#2AFFFFFF" />
                  <Setter TargetName="ButtonSurface" Property="Border.BorderBrush" Value="#45FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="ButtonSurface" Property="Border.Background" Value="#38FFFFFF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="ButtonSurface" Property="Border.Background" Value="#0CFFFFFF" />
                  <Setter TargetName="ButtonSurface" Property="Border.BorderBrush" Value="#14FFFFFF" />
                  <Setter Property="UIElement.Opacity" Value="0.45" />
                  <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="MediaTabButton" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="TabSurface" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="17" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="TabSurface" Property="Border.Background" Value="#2DFFFFFF" />
                  <Setter TargetName="TabSurface" Property="Border.BorderBrush" Value="#50FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="TabSurface" Property="Border.Background" Value="#3AFFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid ClipToBounds="True">
    <controls:LiquidGlassSurface Name="GlassSurface" />
    <Grid Name="FullPlayerPanel" Margin="10,8,18,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="52" />
        <ColumnDefinition />
        <ColumnDefinition Width="112" />
        <ColumnDefinition Width="34" />
      </Grid.ColumnDefinitions>
      <Border Width="50" Height="50" CornerRadius="16" Background="#26FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1">
        <Grid ClipToBounds="True">
          <Image Name="ArtworkImage" Stretch="UniformToFill" Visibility="Collapsed" />
          <TextBlock Name="ArtworkPlaceholder" Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Grid>
      </Border>
      <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
        <TextBlock Name="TitleText" Text="正在播放" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        <TextBlock Name="ArtistText" Text="" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Name="PreviousButton" Style="{StaticResource MediaButton}" ToolTip="上一首" Click="OnPreviousClick">
          <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
        </Button>
        <Button Name="PlayPauseButton" Style="{StaticResource MediaButton}" ToolTip="播放/暂停" Click="OnPlayPauseClick">
          <TextBlock Name="PlayPauseGlyph" Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
        </Button>
        <Button Name="NextButton" Style="{StaticResource MediaButton}" ToolTip="下一首" Click="OnNextClick">
          <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
        </Button>
      </StackPanel>
      <Button Name="ManualCollapseButton" Grid.Column="3" Width="30" Height="36" ToolTip="收回播放器" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" Background="#1FFFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" FocusVisualStyle="{x:Null}" Click="OnManualCollapseClick">
        <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" />
      </Button>
    </Grid>
    <Button Name="SideRevealButton" Visibility="Collapsed" Style="{StaticResource MediaTabButton}" ToolTip="展开媒体播放器" Cursor="Hand" Background="#1FFFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" FocusVisualStyle="{x:Null}" PreviewMouseLeftButtonDown="OnSideRevealPreviewMouseLeftButtonDown" PreviewMouseMove="OnSideRevealPreviewMouseMove" PreviewMouseLeftButtonUp="OnSideRevealPreviewMouseLeftButtonUp">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" Foreground="#FFFFFFFF" />
        <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="8" Margin="0,3,0,0" HorizontalAlignment="Center" Foreground="#FFFFFFFF" />
      </StackPanel>
    </Button>
  </Grid>
</controls:GlassWindow>