<controls:GlassWindow
    x:Class="GlassDesk.Dock.StickyNotesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI"
    Title="桌面便签 &amp; 待办清单"
    Width="320"
    Height="440"
    MinWidth="260"
    MinHeight="300"
    ShowInTaskbar="False"
    WindowStartupLocation="Manual"
    Topmost="False">

  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="IconButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Grip" CornerRadius="8" Background="{TemplateBinding Background}" Padding="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Grip" Property="Background" Value="#25FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Grip" Property="Background" Value="#35FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>

  <Grid ClipToBounds="True">
    <controls:LiquidGlassSurface Name="GlassSurface" UseFrostedMaterial="True" BackgroundClarityOverride="0.32" />
    <Grid Margin="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Title Bar -->
      <DockPanel Grid.Row="0" Margin="0,0,0,10">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Name="PinButton" Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="钉在桌面底层 / 浮动置顶" Click="OnPinClick">
            <TextBlock Name="PinGlyph" Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
          </Button>
          <Button Name="CloseButton" Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="关闭便签" Click="OnCloseClick" Margin="4,0,0,0">
            <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" />
          </Button>
        </StackPanel>
        <TextBlock Text="便签 &amp; 待办" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      </DockPanel>

      <!-- Notes List -->
      <Border Grid.Row="1" CornerRadius="14" Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Name="NotesContainer" />
        </ScrollViewer>
      </Border>

      <!-- Input Bar -->
      <Grid Grid.Row="2" Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Name="NoteInput" Height="32" Padding="8,4" VerticalContentAlignment="Center"
                 Background="#1EFFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1"
                 Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                 CaretBrush="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                 KeyDown="OnNoteInputKeyDown" />
        <Button Grid.Column="1" Content="添加" Width="52" Height="32" Margin="6,0,0,0"
                Cursor="Hand" Background="#2FFFFFFF" BorderBrush="#35FFFFFF"
                Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                Click="OnAddNoteClick" />
      </Grid>

      <!-- Footer Bar -->
      <DockPanel Grid.Row="3" Margin="0,8,0,0">
        <TextBlock Name="SummaryText" Text="共 0 项" FontSize="11" VerticalAlignment="Center"
                   Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="清理已完成" Padding="6,2" FontSize="10.5" Background="Transparent" BorderThickness="0"
                  Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                  Cursor="Hand" Click="OnClearCompletedClick" />
          <Button Content="导出文本" Margin="4,0,0,0" Padding="6,2" FontSize="10.5" Background="Transparent" BorderThickness="0"
                  Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                  Cursor="Hand" Click="OnExportTextClick" />
        </StackPanel>
      </DockPanel>
    </Grid>
  </Grid>
</controls:GlassWindow>
