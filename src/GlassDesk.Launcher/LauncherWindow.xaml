<controls:GlassWindow
    x:Class="GlassDesk.Launcher.LauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI"
    Title="GlassDesk 启动台"
    AutomationProperties.Name="GlassDesk 启动台"
    ShowInTaskbar="False"
    WindowStartupLocation="Manual"
    Topmost="True"
    AllowDrop="True"
    Drop="OnExternalDrop"
    DragLeave="OnLauncherDragLeave"
    DragOver="OnExternalDragOver">
  <controls:GlassWindow.Resources>
    <Style x:Key="FolderActionButton" TargetType="Button">
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="Foreground" Value="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="BorderBrush" Value="#32FFFFFF" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <controls:PhoneBorder CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </controls:PhoneBorder>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2CFFFFFF" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value=".7" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LauncherPageArrow" TargetType="Button">
      <Setter Property="Foreground" Value="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Opacity" Value=".72" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="1" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value=".55" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".25" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LauncherAppTile" TargetType="Button">
      <Setter Property="Foreground" Value="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <controls:PhoneBorder x:Name="TileChrome" CornerRadius="22" Background="{TemplateBinding Background}"
                       BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </controls:PhoneBorder>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TileChrome" Property="Background" Value="#10FFFFFF" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="TileChrome" Property="Background" Value="#18FFFFFF" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GlassBoardToolButton" TargetType="Button">
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="Background" Value="#18FFFFFF" />
      <Setter Property="BorderBrush" Value="#32FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <controls:PhoneBorder CornerRadius="14" Background="{TemplateBinding Background}"
                                   BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                   Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </controls:PhoneBorder>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2EFFFFFF" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </controls:GlassWindow.Resources>
  <Border x:Name="ContainerTransformClipRoot" Background="Transparent"
          BorderThickness="0"
          SnapsToDevicePixels="True">
    <Grid>
      <!-- Background is sampled offscreen; Glass is painted before native Content. -->
      <controls:LiquidGlassSurface x:Name="GlassSurface" UseLauncherTransparency="True" />

      <!-- GlassBoard 风格纯净通透磨砂底衬（默认折叠，切换时与水面材质互斥切换） -->
      <Border x:Name="FrostedBackdrop"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Visibility="Collapsed"
              CornerRadius="36"
              Background="#24141E2C"
              BorderThickness="1"
              SnapsToDevicePixels="True">
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4AFFFFFF" Offset="0" />
            <GradientStop Color="#12FFFFFF" Offset="1" />
          </LinearGradientBrush>
        </Border.BorderBrush>
      </Border>

      <Grid x:Name="LauncherPanelRoot" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid x:Name="LauncherContent" Margin="32,22,32,18" RenderTransformOrigin=".5,.5">
          <Grid.RenderTransform>
            <ScaleTransform x:Name="ContentScaleTransform" ScaleX="1" ScaleY="1" />
          </Grid.RenderTransform>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Row 0: SearchHeader -->
            <RowDefinition Height="Auto" /> <!-- Row 1: SubToolbar -->
            <RowDefinition Height="Auto" /> <!-- Row 2: CategoryTabBar -->
            <RowDefinition Height="Auto" /> <!-- Row 3: BulkBar -->
            <RowDefinition Height="*" />    <!-- Row 4: Grid (PageViewport, GroupPanel, Trash) -->
            <RowDefinition Height="Auto" /> <!-- Row 5: Footer (Status, Pager, Transparency) -->
          </Grid.RowDefinitions>

          <!-- Row 0: 顶栏主操作栏（大搜索胶囊 + 核心快捷按钮组） -->
          <Grid x:Name="SearchHeader" Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 搜索胶囊框 -->
            <controls:PhoneBorder Height="38" CornerRadius="19" Padding="14,0" Background="#14FFFFFF"
                    BorderBrush="{Binding PanelBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    BorderThickness="1" SnapsToDevicePixels="True" Margin="0,0,12,0">
              <Grid>
                <TextBlock x:Name="SearchHint" Text="搜索应用、文件夹…"
                           Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                           VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.65" FontSize="14" />
                <TextBox x:Name="SearchBox" Height="34" FontSize="14.5" VerticalContentAlignment="Center"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         CaretBrush="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                         AutomationProperties.Name="搜索应用" ToolTip="搜索应用名称、拼音或别名"
                         TextChanged="OnSearchChanged" />
              </Grid>
            </controls:PhoneBorder>

            <!-- 右侧快捷操作按钮组 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BatchAddButton" Style="{StaticResource GlassBoardToolButton}" Content="+ 批量添加"
                      Click="OnBatchAddClick" Height="36" Padding="14,0" ToolTip="一键从开始菜单、桌面批量导入" />
              <Button x:Name="MultiSelectButton" Style="{StaticResource GlassBoardToolButton}" Content="多选"
                      Click="OnMultiSelectToggleClick" Height="36" Padding="12,0" ToolTip="跨页多选批量整理" />
              <Button x:Name="SettingsButton" Style="{StaticResource GlassBoardToolButton}" Content="⚙"
                      ToolTip="外观、挂件与系统设置" Click="OnSettingsButtonClick" Height="36" Width="36" Padding="0" />
              <Button x:Name="MoreMenuButton" Style="{StaticResource GlassBoardToolButton}" Content="···"
                      ToolTip="更多与显示选项" Click="OnMoreMenuButtonClick" Height="36" Width="36" Padding="0" />
              <Button x:Name="CloseButton" Style="{StaticResource GlassBoardToolButton}" Content="×"
                      ToolTip="关闭启动台 (Esc)" Click="OnCloseButtonClick" Height="36" Width="36" Padding="0" />
            </StackPanel>
          </Grid>

          <!-- Row 1: 次级工具栏（分组下拉、图标尺寸滑块、快捷增添撤销） -->
          <DockPanel x:Name="SubToolbar" Grid.Row="1" LastChildFill="False" Margin="0,0,0,8">
            <ComboBox x:Name="GroupSelectorCombo" Width="120" Height="28" Margin="0,0,12,0" VerticalAlignment="Center"
                      SelectionChanged="OnGroupSelectorComboSelectionChanged" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock x:Name="IconSizeText" Text="图标 48 px" Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                         VerticalAlignment="Center" Width="72" FontSize="12" />
              <Slider x:Name="BoardIconSlider" Minimum="28" Maximum="80" Value="48" Width="105"
                      TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                      ToolTip="无级调节图标大小与网格密度" ValueChanged="OnBoardIconSliderValueChanged" />
            </StackPanel>
            <Button Style="{StaticResource GlassBoardToolButton}" Content="添加已有图标" Click="OnAddExistingIconClick" Height="28" Margin="0,0,6,0" />
            <Button Style="{StaticResource GlassBoardToolButton}" Content="添加文件夹" Click="OnAddFolderClick" Height="28" Margin="0,0,6,0" />
            <Button Style="{StaticResource GlassBoardToolButton}" Content="新建" Click="OnNewItemMenuClick" Height="28" Margin="0,0,6,0" />
            <Button Style="{StaticResource GlassBoardToolButton}" Content="撤销" Click="OnUndoActionClick" Height="28" Margin="0,0,6,0" />
          </DockPanel>

          <!-- Row 2: 横向分类胶囊标签栏 (Category Tabs) -->
          <ScrollViewer x:Name="CategoryScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                        Focusable="False" Margin="0,0,0,10" HorizontalAlignment="Left">
            <StackPanel x:Name="CategoryTabBar" Orientation="Horizontal" />
          </ScrollViewer>

          <!-- Row 3: 批量整理操作条 (多选激活时展开) -->
          <WrapPanel x:Name="BulkBar" Grid.Row="3" Margin="0,0,0,10" VerticalAlignment="Center" Visibility="Collapsed">
            <Button Style="{StaticResource GlassBoardToolButton}" Content="全选结果" Click="OnBulkSelectAllClick" Height="28" />
            <Button Style="{StaticResource GlassBoardToolButton}" Content="取消全选" Click="OnBulkClearSelectionClick" Height="28" />
            <Button Style="{StaticResource GlassBoardToolButton}" Content="移除已选" Click="OnBulkDeleteSelectedClick" Height="28" Foreground="#FFFF7777" />
            <ComboBox x:Name="BulkMoveTargetCombo" Width="110" Height="28" Margin="6,0,4,0" VerticalAlignment="Center" />
            <Button Style="{StaticResource GlassBoardToolButton}" Content="移动" Click="OnBulkMoveSelectedClick" Height="28" />
            <TextBlock x:Name="BulkSelectionCountText" Text="已选 0 项"
                       Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                       VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" />
          </WrapPanel>

          <!-- Row 4: 主图标网格、文件夹卡片与拖拽回收站 -->
          <Grid Grid.Row="4">
            <Grid x:Name="PageViewport" ClipToBounds="True">
              <ScrollViewer x:Name="OutgoingPageScroll" Visibility="Collapsed" IsHitTestVisible="False" IsEnabled="False"
                            HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                <UniformGrid x:Name="OutgoingPageGrid" MaxWidth="1120" HorizontalAlignment="Center">
                  <UniformGrid.RenderTransform><TranslateTransform x:Name="OutgoingPageMotion" /></UniformGrid.RenderTransform>
                </UniformGrid>
              </ScrollViewer>
              <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                <UniformGrid x:Name="TileGrid" MaxWidth="1120" HorizontalAlignment="Center">
                  <UniformGrid.RenderTransform><TranslateTransform x:Name="IncomingPageMotion" /></UniformGrid.RenderTransform>
                </UniformGrid>
              </ScrollViewer>
            </Grid>
            <Grid x:Name="GroupPanel" Visibility="Collapsed">
              <Border x:Name="FolderDismissArea" Background="#18000000" MouseLeftButtonDown="OnFolderOutsideDown" />
              <Canvas x:Name="FolderCanvas">
                <Path x:Name="FolderShadow" IsHitTestVisible="False" Fill="#13000000" Stroke="#0B000000" StrokeThickness="14" />
                <Grid x:Name="FolderCard" ClipToBounds="True">
                  <controls:SharedGlassLens x:Name="FolderGlass" Radius="44" />
                  <DockPanel x:Name="GroupContent" Margin="18">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                      <Button DockPanel.Dock="Right" Style="{StaticResource FolderActionButton}" Content="关闭" AutomationProperties.Name="关闭分组" Click="OnCloseGroup" />
                      <Button DockPanel.Dock="Right" Style="{StaticResource FolderActionButton}" Content="改名" AutomationProperties.Name="重命名文件夹" Click="OnRenameOpenFolder" Margin="0,0,8,0" />
                      <TextBlock x:Name="GroupTitle" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock x:Name="FolderHint" DockPanel.Dock="Bottom" Text="长按拖动以整理 · 拖出面板可移回启动台" FontSize="11" Opacity=".55" Margin="4,12,0,0" />
                    <ScrollViewer x:Name="GroupScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                      <UniformGrid x:Name="GroupItems" Columns="4" />
                    </ScrollViewer>
                  </DockPanel>
                </Grid>
              </Canvas>
            </Grid>
            <controls:PhoneBorder x:Name="TrashDropTarget" Width="76" Height="58"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                    Visibility="Collapsed" AllowDrop="True"
                    CornerRadius="22" Background="#22EF4444" BorderBrush="#88EF4444"
                    BorderThickness="1" ToolTip="拖到这里可从启动台移除"
                    DragOver="OnTrashDragOver" Drop="OnTrashDrop">
              <Viewbox Width="28" Height="28">
                <Canvas Width="28" Height="28">
                  <Path Stroke="#EF4444" StrokeThickness="2" StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        Data="M 5,7 L 6.2,21.5 C 6.3,22.5 7,23 8,23 H 20 C 21,23 21.7,22.5 21.8,21.5 L 23,7 M 3,5 H 25 M 10,5 V 3 C 10,2 11,1.5 12,1.5 H 16 C 17,1.5 18,2 18,3 V 5 M 10,10 V 20 M 18,10 V 20" />
                </Canvas>
              </Viewbox>
            </controls:PhoneBorder>
          </Grid>

          <!-- Row 5: 底部状态与右下角实时透明度滑块 -->
          <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧状态文字 -->
            <TextBlock x:Name="StatusText" Text="图标可拖到 Dock 固定 · Esc 收起 · 单击磁贴启动"
                       Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="11.5" VerticalAlignment="Center" Opacity="0.75" />

            <!-- 中间翻页控制器 -->
            <StackPanel x:Name="PageControls" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
              <Button x:Name="PreviousPage" Style="{StaticResource LauncherPageArrow}" AutomationProperties.Name="上一页" Click="OnPreviousPage">
                <Path Width="7" Height="12" Stretch="Uniform" Data="M6,1 L1,6 L6,11"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              </Button>
              <TextBlock x:Name="PageText" Margin="14,0" MinWidth="60" TextAlignment="Center" VerticalAlignment="Center"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Button x:Name="NextPage" Style="{StaticResource LauncherPageArrow}" AutomationProperties.Name="下一页" Click="OnNextPage">
                <Path Width="7" Height="12" Stretch="Uniform" Data="M1,1 L6,6 L1,11"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              </Button>
            </StackPanel>

            <!-- 右下角实时透明度滑块 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock x:Name="TransparencyText" Text="透明度 70%"
                         Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                         VerticalAlignment="Center" Width="76" FontSize="11.5" TextAlignment="Right" Margin="0,0,6,0" />
              <Slider x:Name="TransparencySlider" Minimum="10" Maximum="100" Value="70" Width="110"
                      TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                      ToolTip="只调整启动台毛玻璃透明度，文字与图标保持锐利"
                      ValueChanged="OnTransparencySliderValueChanged" />
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>

      <controls:LaunchpadGlyph x:Name="CollapsedGlyph" IsHitTestVisible="False"
            OutlineBrush="{Binding DockBuiltinIconBrush, RelativeSource={RelativeSource AncestorType=Window}}"
            IsFilled="{Binding LaunchpadIconFilled, RelativeSource={RelativeSource AncestorType=Window}}"
            HorizontalAlignment="Left" VerticalAlignment="Top" Width="48" Height="48" Opacity="0" />
      <Canvas x:Name="DragOverlay" IsHitTestVisible="False" />
    </Grid>
  </Border>
</controls:GlassWindow>
